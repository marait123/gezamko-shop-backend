# Django settings
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database settings
DB_NAME=gezamko_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS settings
CORS_ALLOWED_ORIGINS=http://localhost:3005,http://127.0.0.1:3005

# Keycloak settings
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=gezamko
KEYCLOAK_CLIENT_ID=gezamko-backend
KEYCLOAK_CLIENT_SECRET=your-client-secret

# Paymob settings
PAYMOB_API_KEY=your-paymob-api-key
PAYMOB_INTEGRATION_ID=your-integration-id
PAYMOB_IFRAME_ID=your-iframe-id
PAYMOB_HMAC_SECRET=your-hmac-secret

# Posta shipping settings
POSTA_API_KEY=your-posta-api-key
POSTA_API_URL=https://api.posta.com

# Celery settings
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Logging
DJANGO_LOG_LEVEL=INFO
